# Desarrollo local — SQLite
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cva-deportes-secret-key-2024-muy-segura"

# En Railway, estas variables se configuran en el panel:
# DATABASE_URL   → se genera automáticamente al agregar PostgreSQL
# NEXTAUTH_URL   → la URL pública de tu servicio (ej: https://cva-deportes.up.railway.app)
# NEXTAUTH_SECRET → genera uno seguro con: openssl rand -base64 32
